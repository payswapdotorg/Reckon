# .env.example — Reckon environment separation (P1-004).
#
# Copy per-environment: .env (local dev), .env.test, or inject via the
# deployment platform's env store (NEVER commit real values — .gitignore
# excludes .env and .env.*; only this .example is tracked).
#
# Full matrix + handling rules: docs/deployment/environment.md
# Migration workflow: docs/deployment/migrations.md

# --- required (production) ---------------------------------------------------
# PostgreSQL connection string (ADR-001: the ONLY production authority).
# Neon in deployment — include TLS: postgres://user:pass@host/db?sslmode=require
# The production composition REFUSES to boot without this (no hidden
# in-memory authority).
export DATABASE_URL='postgres://user:pass@localhost:5432/reckon'

# --- auth ---------------------------------------------------------------------
# Static API keys: 'apiKey:tenantId:scope1,scope2' entries, ';' or newline
# separated. Keys are hashed at rest by the KeyStore. RECKON_API_KEYS_FILE
# (a path) wins over RECKON_API_KEYS when set. Empty ⇒ every authenticated
# route returns 401 (the API still boots; healthz/readyz stay open).
export RECKON_API_KEYS='devkey:demo-tenant:decisions,plans,catalog,experiences,preferences,outcomes,candidates,research'
# export RECKON_API_KEYS_FILE=/run/secrets/reckon_api_keys

# --- serving ------------------------------------------------------------------
# Integer 1..65535 — anything else fails fast at boot (ConfigError).
export RECKON_PORT=8080
# Loopback by default; public deployment sets the platform bind host explicitly.
export RECKON_HOST=127.0.0.1

# --- behavior -----------------------------------------------------------------
# '1' enables the fastify request logger (structured JSON on stdout).
export RECKON_LOG=0
# Reported by /healthz + /readyz (defaults to 0.1.0).
export RECKON_API_VERSION=0.1.0
