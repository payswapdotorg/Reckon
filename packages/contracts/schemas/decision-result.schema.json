{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "default": "reckon.decision-result",
      "type": "string",
      "const": "reckon.decision-result"
    },
    "schemaVersion": {
      "default": "0.1.0",
      "type": "string"
    },
    "decisionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "tenant": {
      "type": "object",
      "properties": {
        "tenantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "tenantId"
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "HOLD",
        "CONTINUE",
        "QUEUE",
        "SUGGEST",
        "SWITCH",
        "INTERRUPT",
        "RESUME",
        "END"
      ]
    },
    "selectedExperience": {
      "type": "object",
      "properties": {
        "schema": {
          "default": "reckon.experience",
          "type": "string",
          "const": "reckon.experience"
        },
        "schemaVersion": {
          "default": "0.1.0",
          "type": "string"
        },
        "experienceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "itemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "realizationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "format": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "full",
                "clip",
                "segment",
                "audio-only",
                "text-summary",
                "translated",
                "dubbed",
                "subtitled",
                "interactive",
                "card",
                "banner",
                "notification",
                "email",
                "push",
                "in-feed",
                "interstitial",
                "custom"
              ]
            },
            "customKind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "params": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "kind"
          ]
        },
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "duration": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^P(?!$)"
            }
          ]
        },
        "timing": {
          "type": "object",
          "properties": {
            "earliestMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "latestMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "availabilityWindow": {
              "type": "object",
              "properties": {
                "fromMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "untilMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "fromMs",
                "untilMs"
              ]
            }
          }
        },
        "objectiveFit": {
          "type": "object",
          "properties": {
            "objective": {
              "type": "object",
              "properties": {
                "objectiveId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                },
                "version": {
                  "default": "1",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "learn",
                    "relax",
                    "discover",
                    "catch-up",
                    "shop",
                    "find-gift",
                    "compare",
                    "complete-task",
                    "be-entertained",
                    "stay-informed",
                    "custom"
                  ]
                },
                "customKind": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "params": {
                  "default": {},
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": [
                "objectiveId",
                "kind"
              ]
            },
            "fitScore": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "notes": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        "requirements": {
          "type": "object",
          "properties": {
            "deviceClass": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              }
            },
            "requiresScreen": {
              "type": "boolean"
            },
            "requiresAudio": {
              "type": "boolean"
            },
            "minBandwidth": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            }
          }
        },
        "transformations": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "params": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "constraints": {
          "default": [],
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "time-window"
                  },
                  "fromMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "untilMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "min-duration"
                  },
                  "seconds": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "kind",
                  "seconds"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "max-duration"
                  },
                  "seconds": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "kind",
                  "seconds"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "format-required"
                  },
                  "format": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                },
                "required": [
                  "kind",
                  "format"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "format-forbidden"
                  },
                  "format": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                },
                "required": [
                  "kind",
                  "format"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "locale-required"
                  },
                  "locale": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 35
                  }
                },
                "required": [
                  "kind",
                  "locale"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "device-class-required"
                  },
                  "deviceClass": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32
                  }
                },
                "required": [
                  "kind",
                  "deviceClass"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "max-cost"
                  },
                  "cost": {
                    "type": "number",
                    "minimum": 0
                  },
                  "currency": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 3
                  }
                },
                "required": [
                  "kind",
                  "cost"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "max-latency"
                  },
                  "latencyMs": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "kind",
                  "latencyMs"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "catalog-rule"
                  },
                  "ruleId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": [
                  "kind",
                  "ruleId"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "policy-rights"
                  },
                  "gateId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": [
                  "kind",
                  "gateId"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "custom"
                  },
                  "constraintId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "params": {
                    "default": {},
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "kind",
                  "constraintId"
                ]
              }
            ]
          }
        }
      },
      "required": [
        "experienceId",
        "itemId",
        "realizationId",
        "format"
      ]
    },
    "alternatives": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "experienceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "score": {
            "type": "number"
          },
          "uncertainty": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "spread": {
                "type": "number",
                "minimum": 0
              },
              "disagreement": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "oodScore": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "method": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "excludedBy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "experienceId"
        ]
      }
    },
    "uncertainty": {
      "type": "object",
      "properties": {
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "spread": {
          "type": "number",
          "minimum": 0
        },
        "disagreement": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "oodScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "policy": {
      "type": "object",
      "properties": {
        "policyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "policyId",
        "version"
      ]
    },
    "scheduleDelta": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "HOLD",
            "CONTINUE",
            "QUEUE",
            "SUGGEST",
            "SWITCH",
            "INTERRUPT",
            "RESUME",
            "END"
          ]
        },
        "planId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "enqueue": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "dequeue": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "resumeCheckpoint": {
          "type": "object",
          "properties": {
            "experienceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "resumeToken": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": [
            "experienceId",
            "resumeToken"
          ]
        }
      },
      "required": [
        "action"
      ]
    },
    "reasons": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "system"
      ]
    },
    "latency": {
      "type": "object",
      "properties": {
        "latencyMsP50": {
          "type": "number",
          "minimum": 0
        },
        "latencyMsP95": {
          "type": "number",
          "minimum": 0
        },
        "inferenceCost": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        }
      }
    },
    "at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "decisionId",
    "requestId",
    "tenant",
    "action",
    "policy",
    "at"
  ],
  "$id": "https://reckon.dev/schemas/decision-result.schema.json"
}
