{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "default": "reckon.complete.conformance-verdict",
      "type": "string",
      "const": "reckon.complete.conformance-verdict"
    },
    "schemaVersion": {
      "default": "0.1.0",
      "type": "string"
    },
    "verdictId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "manifestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "manifestChecksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reckonComplete": {
      "type": "boolean"
    },
    "coverage": {
      "type": "object",
      "properties": {
        "required": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "satisfied": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "partial": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "missing": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "coverageRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "perCapability": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "capability": {
                "type": "string",
                "enum": [
                  "tenant-identity",
                  "catalog-registration",
                  "realization-declaration",
                  "candidate-retrieval",
                  "context-snapshots",
                  "objective-declaration",
                  "constraint-declaration",
                  "attention-policy",
                  "decision-request",
                  "decision-retrieval",
                  "experience-resolution",
                  "plan-management",
                  "schedule-execution",
                  "outcome-return",
                  "preference-feedback",
                  "evidence-retrieval",
                  "webhook-delivery",
                  "ad-memory",
                  "agent-delegation",
                  "conformance-verification"
                ]
              },
              "state": {
                "type": "string",
                "enum": [
                  "satisfied",
                  "partial",
                  "missing"
                ]
              },
              "evidenceClass": {
                "type": "string",
                "enum": [
                  "fixture",
                  "controlled-local",
                  "staging",
                  "production-observed",
                  "simulated",
                  "counterfactual"
                ]
              },
              "evidenceSufficient": {
                "type": "boolean"
              },
              "friction": {
                "type": "string",
                "enum": [
                  "CONTRACT_GAP",
                  "API_GAP",
                  "SDK_GAP",
                  "COMPOSITION_GAP",
                  "PERSISTENCE_GAP",
                  "CAPABILITY_GAP",
                  "ADAPTER_GAP",
                  "OBSERVABILITY_GAP",
                  "UX_DX_GAP",
                  "HOST_RESPONSIBILITY",
                  "RIGHTS_POLICY_BOUNDARY"
                ]
              },
              "detail": {
                "type": "string",
                "maxLength": 2048
              }
            },
            "required": [
              "capability",
              "state",
              "evidenceSufficient"
            ]
          }
        }
      },
      "required": [
        "required",
        "satisfied",
        "partial",
        "missing",
        "coverageRatio",
        "perCapability"
      ]
    },
    "evidenceClass": {
      "type": "string",
      "enum": [
        "fixture",
        "controlled-local",
        "staging",
        "production-observed",
        "simulated",
        "counterfactual"
      ]
    },
    "evidenceSufficient": {
      "type": "boolean"
    },
    "gaps": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "capability": {
            "type": "string",
            "enum": [
              "tenant-identity",
              "catalog-registration",
              "realization-declaration",
              "candidate-retrieval",
              "context-snapshots",
              "objective-declaration",
              "constraint-declaration",
              "attention-policy",
              "decision-request",
              "decision-retrieval",
              "experience-resolution",
              "plan-management",
              "schedule-execution",
              "outcome-return",
              "preference-feedback",
              "evidence-retrieval",
              "webhook-delivery",
              "ad-memory",
              "agent-delegation",
              "conformance-verification"
            ]
          },
          "friction": {
            "type": "string",
            "enum": [
              "CONTRACT_GAP",
              "API_GAP",
              "SDK_GAP",
              "COMPOSITION_GAP",
              "PERSISTENCE_GAP",
              "CAPABILITY_GAP",
              "ADAPTER_GAP",
              "OBSERVABILITY_GAP",
              "UX_DX_GAP",
              "HOST_RESPONSIBILITY",
              "RIGHTS_POLICY_BOUNDARY"
            ]
          },
          "detail": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "required": [
          "capability",
          "friction"
        ]
      }
    },
    "measuredAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "verdictId",
    "profileId",
    "manifestId",
    "manifestChecksum",
    "reckonComplete",
    "coverage",
    "evidenceSufficient",
    "measuredAt"
  ],
  "$id": "https://reckon.dev/schemas/reckon-complete-conformance-verdict.schema.json"
}
