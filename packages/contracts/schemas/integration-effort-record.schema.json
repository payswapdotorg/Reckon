{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "default": "reckon.complete.integration-effort-record",
      "type": "string",
      "const": "reckon.complete.integration-effort-record"
    },
    "schemaVersion": {
      "default": "0.1.0",
      "type": "string"
    },
    "recordId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "harnessVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "seed": {
      "type": "string",
      "pattern": "^[0-9]{1,20}$"
    },
    "hostAdapterId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "hostSystem": {
      "type": "object",
      "properties": {
        "hostId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "hostAdapterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "hostId",
        "name",
        "hostAdapterId",
        "version"
      ]
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "ladderLevel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "manifestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "manifestChecksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidenceClass": {
      "type": "string",
      "enum": [
        "fixture",
        "controlled-local",
        "staging",
        "production-observed",
        "simulated",
        "counterfactual"
      ]
    },
    "apiOperations": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "sdkMethods": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "glue": {
      "type": "object",
      "properties": {
        "functions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "loc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "customAdapterLoc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "functions",
        "loc",
        "customAdapterLoc"
      ]
    },
    "internalImports": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timing": {
      "type": "object",
      "properties": {
        "firstDecisionMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "firstDecisionSteps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fullLoopMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fullLoopSteps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "firstDecisionMs",
        "firstDecisionSteps",
        "fullLoopMs",
        "fullLoopSteps"
      ]
    },
    "latency": {
      "type": "object",
      "properties": {
        "p50Ms": {
          "type": "number",
          "minimum": 0
        },
        "p95Ms": {
          "type": "number",
          "minimum": 0
        },
        "samples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "p50Ms",
        "p95Ms",
        "samples"
      ]
    },
    "failures": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "retriedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "retryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exhaustedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "count",
        "retriedCount",
        "retryCount",
        "exhaustedCount"
      ]
    },
    "capabilityCoverage": {
      "type": "object",
      "properties": {
        "required": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "satisfied": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "partial": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "missing": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "coverageRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "perCapability": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "capability": {
                "type": "string",
                "enum": [
                  "tenant-identity",
                  "catalog-registration",
                  "realization-declaration",
                  "candidate-retrieval",
                  "context-snapshots",
                  "objective-declaration",
                  "constraint-declaration",
                  "attention-policy",
                  "decision-request",
                  "decision-retrieval",
                  "experience-resolution",
                  "plan-management",
                  "schedule-execution",
                  "outcome-return",
                  "preference-feedback",
                  "evidence-retrieval",
                  "webhook-delivery",
                  "ad-memory",
                  "agent-delegation",
                  "conformance-verification"
                ]
              },
              "state": {
                "type": "string",
                "enum": [
                  "satisfied",
                  "partial",
                  "missing"
                ]
              },
              "evidenceClass": {
                "type": "string",
                "enum": [
                  "fixture",
                  "controlled-local",
                  "staging",
                  "production-observed",
                  "simulated",
                  "counterfactual"
                ]
              },
              "evidenceSufficient": {
                "type": "boolean"
              },
              "friction": {
                "type": "string",
                "enum": [
                  "CONTRACT_GAP",
                  "API_GAP",
                  "SDK_GAP",
                  "COMPOSITION_GAP",
                  "PERSISTENCE_GAP",
                  "CAPABILITY_GAP",
                  "ADAPTER_GAP",
                  "OBSERVABILITY_GAP",
                  "UX_DX_GAP",
                  "HOST_RESPONSIBILITY",
                  "RIGHTS_POLICY_BOUNDARY"
                ]
              },
              "detail": {
                "type": "string",
                "maxLength": 2048
              }
            },
            "required": [
              "capability",
              "state",
              "evidenceSufficient"
            ]
          }
        }
      },
      "required": [
        "required",
        "satisfied",
        "partial",
        "missing",
        "coverageRatio",
        "perCapability"
      ]
    },
    "gaps": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "capability": {
            "type": "string",
            "enum": [
              "tenant-identity",
              "catalog-registration",
              "realization-declaration",
              "candidate-retrieval",
              "context-snapshots",
              "objective-declaration",
              "constraint-declaration",
              "attention-policy",
              "decision-request",
              "decision-retrieval",
              "experience-resolution",
              "plan-management",
              "schedule-execution",
              "outcome-return",
              "preference-feedback",
              "evidence-retrieval",
              "webhook-delivery",
              "ad-memory",
              "agent-delegation",
              "conformance-verification"
            ]
          },
          "friction": {
            "type": "string",
            "enum": [
              "CONTRACT_GAP",
              "API_GAP",
              "SDK_GAP",
              "COMPOSITION_GAP",
              "PERSISTENCE_GAP",
              "CAPABILITY_GAP",
              "ADAPTER_GAP",
              "OBSERVABILITY_GAP",
              "UX_DX_GAP",
              "HOST_RESPONSIBILITY",
              "RIGHTS_POLICY_BOUNDARY"
            ]
          },
          "detail": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "required": [
          "capability",
          "friction"
        ]
      }
    },
    "replayInputs": {
      "type": "object",
      "properties": {
        "seed": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        "manifestChecksum": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "hostAdapterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "harnessVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "faultRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maxRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "clockStartMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "clockStepMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "seed",
        "manifestChecksum",
        "hostAdapterId",
        "harnessVersion",
        "steps",
        "faultRate",
        "maxRetries",
        "clockStartMs",
        "clockStepMs"
      ]
    },
    "checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "completedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "recordId",
    "runId",
    "harnessVersion",
    "seed",
    "hostAdapterId",
    "hostSystem",
    "profileId",
    "manifestId",
    "manifestChecksum",
    "evidenceClass",
    "glue",
    "internalImports",
    "timing",
    "latency",
    "failures",
    "capabilityCoverage",
    "replayInputs",
    "checksum",
    "completedAt"
  ],
  "$id": "https://reckon.dev/schemas/integration-effort-record.schema.json"
}
