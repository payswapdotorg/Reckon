                    }
                  },
                  "required": [
                    "kind",
                    "constraintId"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "experienceId",
          "itemId",
          "realizationId",
          "format"
        ]
      }
    },
    "planningHorizon": {
      "type": "object",
      "properties": {
        "seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxItems": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "replanTriggers": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "context-changed",
          "objective-changed",
          "candidate-unavailable",
          "new-candidate",
          "user-feedback",
          "fatigue-signal",
          "outcome-observed",
          "budget-exhausted",
          "host-request",
          "custom"
        ]
      }
    },
    "interruptionPolicy": {
      "type": "object",
      "properties": {
        "policyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "default": "1",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "policyId"
      ]
    },
    "resumeCheckpoints": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "experienceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "resumeToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "position": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "savedAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "experienceId",
          "resumeToken",
          "savedAt"
        ]
      }
    },
    "createdAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "updatedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "planId",
    "tenant",
    "subject",
    "objective",
    "attentionPolicy",
    "createdAt",
    "updatedAt"
  ],
  "$id": "https://reckon.dev/schemas/experience-plan.schema.json"
}
