{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "default": "reckon.ad-forget-result",
      "type": "string",
      "const": "reckon.ad-forget-result"
    },
    "schemaVersion": {
      "default": "0.1.0",
      "type": "string"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "tenant": {
      "type": "object",
      "properties": {
        "tenantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "tenantId"
      ]
    },
    "forgottenCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "forgottenRecordIds": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "requestId",
    "tenant",
    "forgottenCount",
    "at"
  ],
  "$id": "https://reckon.dev/schemas/ad-forget-result.schema.json"
}
