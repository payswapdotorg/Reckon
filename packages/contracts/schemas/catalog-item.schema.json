{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "default": "reckon.catalog-item",
      "type": "string",
      "const": "reckon.catalog-item"
    },
    "schemaVersion": {
      "default": "0.1.0",
      "type": "string"
    },
    "itemId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "media",
        "commerce",
        "advertising",
        "notification",
        "article",
        "other"
      ]
    },
    "labels": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "attributes": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "availableFrom": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "availableUntil": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "itemId",
    "kind"
  ],
  "$id": "https://reckon.dev/schemas/catalog-item.schema.json"
}
