{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "default": "reckon.outcome-event",
      "type": "string",
      "const": "reckon.outcome-event"
    },
    "schemaVersion": {
      "default": "0.1.0",
      "type": "string"
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "tenant": {
      "type": "object",
      "properties": {
        "tenantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "tenantId"
      ]
    },
    "decisionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "experienceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "subject": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user",
            "audience",
            "account",
            "session"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "kind",
        "ref"
      ]
    },
    "eventType": {
      "type": "string",
      "enum": [
        "impression",
        "start",
        "completion",
        "abandonment",
        "seek",
        "skip",
        "save",
        "share",
        "purchase",
        "conversion",
        "explicit-feedback",
        "interruption-accept",
        "interruption-reject",
        "return",
        "resume",
        "context-transition",
        "correction",
        "custom"
      ]
    },
    "customEventType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "occurredAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "context": {
      "type": "object",
      "properties": {
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "contextId"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "system"
      ]
    },
    "metrics": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "evidenceClass": {
      "type": "string",
      "enum": [
        "fixture",
        "controlled-local",
        "staging",
        "production-observed",
        "simulated",
        "counterfactual"
      ]
    },
    "correctsEventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  },
  "required": [
    "eventId",
    "tenant",
    "subject",
    "eventType",
    "occurredAt",
    "evidenceClass",
    "idempotencyKey"
  ],
  "$id": "https://reckon.dev/schemas/outcome-event.schema.json"
}
