{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "default": "reckon.complete.profile-declaration",
      "type": "string",
      "const": "reckon.complete.profile-declaration"
    },
    "schemaVersion": {
      "default": "0.1.0",
      "type": "string"
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "maxLength": 2048
    },
    "ladderLevel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "requiredCapabilities": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "capability": {
            "type": "string",
            "enum": [
              "tenant-identity",
              "catalog-registration",
              "realization-declaration",
              "candidate-retrieval",
              "context-snapshots",
              "objective-declaration",
              "constraint-declaration",
              "attention-policy",
              "decision-request",
              "decision-retrieval",
              "experience-resolution",
              "plan-management",
              "schedule-execution",
              "outcome-return",
              "preference-feedback",
              "evidence-retrieval",
              "webhook-delivery",
              "ad-memory",
              "agent-delegation",
              "conformance-verification"
            ]
          },
          "minimumEvidenceClass": {
            "type": "string",
            "enum": [
              "fixture",
              "controlled-local",
              "staging",
              "production-observed",
              "simulated",
              "counterfactual"
            ]
          }
        },
        "required": [
          "capability"
        ]
      }
    },
    "requiredEvidenceClass": {
      "type": "string",
      "enum": [
        "fixture",
        "controlled-local",
        "staging",
        "production-observed",
        "simulated",
        "counterfactual"
      ]
    },
    "declaredAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "profileId",
    "name",
    "requiredCapabilities",
    "declaredAt"
  ],
  "$id": "https://reckon.dev/schemas/reckon-complete-profile-declaration.schema.json"
}
