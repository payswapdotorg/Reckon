{
  "name": "@reckon/contracts",
  "version": "0.1.0",
  "description": "Reckon canonical public contracts — versioned schemas, deterministic serialization and digests. FROZEN by CONTRACT-001; changes require a TL3 Architecture Change Record.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
