{
  "name": "@reckon/api",
  "version": "0.1.0",
  "description": "HTTP API + auth/tenant boundary (W3 lane): fastify composition root with contract-validated routes, static bearer key auth, tenant/scope enforcement, typed error envelope and idempotent POST replay. P1-002: production composition (real W2 kernel handlers over real PostgreSQL persistence).",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "pnpm dlx tsx src/main.ts",
    "bundle:vercel": "pnpm --filter @reckon/contracts build && node scripts/bundle-vercel.mjs"
  },
  "dependencies": {
    "@reckon/contracts": "workspace:*",
    "@reckon/decision": "workspace:*",
    "@reckon/events": "workspace:*",
    "@reckon/experience": "workspace:*",
    "@reckon/integrations": "workspace:*",
    "@reckon/observability": "workspace:*",
    "@reckon/persistence": "workspace:*",
    "@reckon/scheduler": "workspace:*",
    "fastify": "^5.12.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@reckon/sdk": "workspace:*",
    "esbuild": "^0.28.2"
  }
}
